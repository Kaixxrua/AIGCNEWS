# 后端统一出站代理。默认使用腾讯云 WireGuard SOCKS5，并由代理端解析 DNS。
OUTBOUND_PROXY=socks5h://10.20.0.1:1080
# 人工切换到宿主机 Mihomo 时改为下值，并仅重建 backend-api：
# OUTBOUND_PROXY=http://host.docker.internal:7897
# docker compose -f docker/docker-compose.yml up -d --no-deps --force-recreate backend-api

# HuggingFace 镜像（国内环境解决下载超时，如无需要可删除）
HF_ENDPOINT=https://hf-mirror.com

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=aigc_docs
MILVUS_DIMENSION=1024
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

SQLITE_PATH=./data/sqlite/app.db

# ── LLM Provider 配置 ────────────────────────────────────────────────
# 可选值：openai | anthropic | ollama
#
# 方案 A：OpenAI 官方 / 第三方兼容代理（不支持思维链透传）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
#
# 方案 B：Anthropic 原生 API（推荐，支持 Extended Thinking 流式思维链）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=           # 留空使用官方端点；可填第三方代理地址
# ANTHROPIC_THINKING_BUDGET=5000  # thinking tokens 预算，0 = 关闭思维链
#
# 方案 C：Ollama 本地模型（DeepSeek-R1 等推理模型支持 <think> 格式思维链）
# LLM_PROVIDER=ollama
# CHAT_MODEL_NAME=deepseek-r1:7b

# ── Embedding Provider 配置 ───────────────────────────────────────────
# 可选值：openai | huggingface | ollama
# 推荐使用 openai（远程 API，不消耗本地 CPU），配合 SiliconFlow 等兼容服务
# 留空 EMBEDDING_API_KEY / EMBEDDING_BASE_URL 则复用 OPENAI_API_KEY / OPENAI_BASE_URL
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_NAME=BAAI/bge-m3
CHAT_MODEL_NAME=claude-4.6-sonnet
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# ── 联网搜索配置（使用 Kimi $web_search builtin_function）─────────────────────
# 需要申请 Moonshot AI API Key：https://platform.moonshot.cn
# KIMI_BASE_URL 和 KIMI_MODEL 有默认值，通常只需填写 KIMI_API_KEY
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview

# 以下为旧三方搜索配置（已废弃，保留兼容）
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

ARXIV_MCP_URL=
GITHUB_MCP_URL=
NEWS_SOURCE_URL=
GITHUB_TOKEN=

# Product Hunt API v2 Developer Token（绕过 Cloudflare，推荐配置）
# 免费申请：https://www.producthunt.com/v2/oauth/applications
# 创建应用后获取 Developer Token，填入下方
PRODUCTHUNT_API_TOKEN=

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

SSE_HEARTBEAT_INTERVAL=15

SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_CRON_INGEST=0 */3 * * *
SCHEDULER_CRON_DAILY_BRIEF=0 9 * * *

LOG_LEVEL=INFO

# 运行环境：development（开发热重载自动清缓存）/ production（生产保留缓存）
ENV=production

# ── 前端品牌配置（Vite 环境变量，需 VITE_ 前缀） ─────────────────────
VITE_APP_BRAND_NAME=AIGC NEWS

# ── MySQL 数据库配置 ──────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rag_aigc

# ── Redis 配置 ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT 鉴权配置 ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── SMTP 邮件配置（Phase 4 邮箱验证码） ───────────────────────────────
# SMTP_HOST 留空则进入 dev 模式：验证码直接打印到控制台日志，不发送邮件
# 生产环境请填写真实 SMTP 服务器信息
# 邮件发送配置 (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_PMPT8x8M_53m3rVg1Lsez9gHBoKiUQBXX
SMTP_FROM_EMAIL=noreply@aigcnews.cn
SMTP_FROM_NAME=AIGCNEWS
SMTP_USE_TLS=true

# ── 注册邀请码（内测阶段固定值） ──────────────────────────────────────
AUTH_REGISTER_INVITE_CODE=internal_testing

# ── SiliconFlow API 配置（Reranker + 视觉模型） ───────────────────────
# 用于 /v1/rerank（Reranker）和 /v1/chat/completions（视觉问答）
SILICONFLOW_API_KEY=sk-zrzgdszgakmufhierwywatlfooyeqnchdmhjtshtdrkafmww
RERANKER_MODEL_NAME=Pro/BAAI/bge-reranker-v2-m3
# 视觉模型（与 SILICONFLOW_API_KEY 复用同一 key，保留兼容旧配置项）
VISION_API_KEY=
