# 后端统一出站代理。普通请求使用环境代理；安全网页抓取器在直连失败后显式回退到此代理。
# 抓取器通常会固定本地校验过的公网 IP；YouTube 等会被污染 DNS 的受限域名由 socks5h 代理解析。
OUTBOUND_PROXY=socks5h://10.20.0.1:1080
# 人工切换到宿主机 Mihomo 时改为下值，并仅重建 backend-api：
# OUTBOUND_PROXY=http://host.docker.internal:7897
# docker compose -f docker/docker-compose.yml up -d --no-deps --force-recreate backend-api

# HuggingFace 镜像（国内环境解决下载超时，如无需要可删除）
HF_ENDPOINT=https://hf-mirror.com

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=aigc_docs
MILVUS_DIMENSION=1024
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# Milvus 对象存储 MinIO 凭据：docker compose 必配（无默认值，缺失则 config 报错）。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# GitHub AI 项目搜索策略（legacy 为生产默认；shadow 仅对比，v2 才切换排序）
PROJECT_AI_SEARCH_STRATEGY=legacy
PROJECT_SEARCH_SHADOW_SAMPLE_RATE=0.0
PROJECT_SEARCH_SHADOW_WORKERS=2
PROJECT_SEARCH_SHADOW_CAPACITY=8
PROJECT_SEARCH_SHADOW_TIMEOUT_SECONDS=1.0
PROJECT_SEARCH_SHADOW_RECENT_CASE_LIMIT=20

# 可插拔采集源（默认关闭；敏感实现以插件形式提供，见 services/source_plugins）
X_SOURCE_ENABLED=false
WECHAT_SOURCE_ENABLED=false

# GitHub 项目语义索引（首次 backfill 完成前保持关闭）
PROJECT_SEMANTIC_SEARCH_ENABLED=false
PROJECT_SEMANTIC_INDEXING_ENABLED=false
PROJECT_SEMANTIC_COLLECTION_NAME=aigc_github_projects_v1
PROJECT_SEMANTIC_INDEX_VERSION=v1
PROJECT_SEMANTIC_MIN_SCORE=0.45
PROJECT_SEMANTIC_REPO_LIMIT=200
PROJECT_SEMANTIC_CHUNK_LIMIT=800
PROJECT_SEMANTIC_QUERY_TIMEOUT_SECONDS=6.0
PROJECT_SEMANTIC_README_MAX_CHARS=40000
PROJECT_SEMANTIC_SYNC_BATCH_SIZE=100
PROJECT_SEMANTIC_SYNC_CONCURRENCY=20

# 项目搜索精排（默认关闭；先通过 shadow/benchmark 验证后再启用）
PROJECT_RERANKER_ENABLED=false
PROJECT_RERANKER_URL=https://api.siliconflow.cn/v1/rerank
PROJECT_RERANKER_MODEL_NAME=Pro/BAAI/bge-reranker-v2-m3
PROJECT_RERANKER_TIMEOUT_SECONDS=1.0
PROJECT_RERANKER_CANDIDATE_LIMIT=20
PROJECT_RERANKER_MIN_CANDIDATES=5

# NEO4J_PASSWORD 同时为 neo4j 容器初始凭据（compose 必配，无默认值）。
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

# PostgreSQL 是应用与项目目录的唯一生产关系数据库。
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_SSLMODE=require
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# ── LLM Provider 配置 ────────────────────────────────────────────────
# 可选值：openai | anthropic | ollama
#
# 方案 A：OpenAI 官方 / 第三方兼容代理（不支持思维链透传）
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
#
# 方案 B：Anthropic 原生 API（推荐，支持 Extended Thinking 流式思维链）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=           # 留空使用官方端点；可填第三方代理地址
# ANTHROPIC_THINKING_BUDGET=5000  # thinking tokens 预算，0 = 关闭思维链
#
# 方案 C：Ollama 本地模型（DeepSeek-R1 等推理模型支持 <think> 格式思维链）
# LLM_PROVIDER=ollama
# CHAT_MODEL_NAME=deepseek-r1:7b

# ── Embedding Provider 配置 ───────────────────────────────────────────
# 可选值：openai | huggingface | ollama
# 推荐使用 openai（远程 API，不消耗本地 CPU），配合 SiliconFlow 等兼容服务
# SiliconFlow：EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1，API Key 填入 EMBEDDING_API_KEY
# 留空 EMBEDDING_API_KEY / EMBEDDING_BASE_URL 则复用 OPENAI_API_KEY / OPENAI_BASE_URL
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_NAME=BAAI/bge-m3
CHAT_MODEL_NAME=claude-4.6-sonnet
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT=300
# 单条 X 翻译硬超时（秒），超时后任务失败并保留供重试。
X_TRANSLATION_TIMEOUT_SECONDS=120

# ── 联网搜索配置（使用 Kimi $web_search builtin_function）─────────────────────
# 需要申请 Moonshot AI API Key：https://platform.moonshot.cn
# KIMI_BASE_URL 和 KIMI_MODEL 有默认值，通常只需填写 KIMI_API_KEY
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview

GITHUB_TOKEN=

# Product Hunt API v2 Developer Token（绕过 Cloudflare，推荐配置）
# 免费申请：https://www.producthunt.com/v2/oauth/applications
# 创建应用后获取 Developer Token，填入下方
PRODUCTHUNT_API_TOKEN=

# ── X/Twitter 采集（twitter-cli，主账号 cookie 凭据）─────────────────────────
# ⚠️ 使用主账号 cookie 抓取，存在风控/封号风险。已内置温和节奏：每 2 小时一轮、
#    账号间隔抖动延迟、user_id 24h 缓存、认证失效/限流即中止整轮。
#    cookie 提取与失效重配步骤见 docs/x-source-runbook.md
# TWITTER_AUTH_TOKEN / TWITTER_CT0：浏览器登录 x.com 后从开发者工具提取
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# 关注账号 watchlist（逗号分隔，@ 可选），如：openai,anthropic,karpathy
TWITTER_WATCH_HANDLES=
# 每账号每轮抓取条数 / 账号间隔基线秒数（实际延迟带 [0.8,1.6) 抖动）
TWITTER_TWEETS_PER_ACCOUNT=20
TWITTER_INTER_ACCOUNT_DELAY_SECONDS=5.0

API_HOST=0.0.0.0
API_PORT=8000

# CORS 允许来源（逗号分隔，不含路径）。仅前端开发服务器与生产域名需要。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aigcnews.cn,https://www.aigcnews.cn

# 可信反向代理（逗号分隔 IP/CIDR）：仅直连对端命中才采信 X-Forwarded-For
# 首跳，防 XFF 伪造绕过 IP 限速。默认仅回环；生产经编排内 nginx 回源时必须
# 加入编排网段，例如：
# TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
TRUSTED_PROXY_IPS=127.0.0.1,::1

SSE_HEARTBEAT_INTERVAL=15

SCHEDULER_TIMEZONE=Asia/Shanghai

# 运行环境：development（开发热重载自动清缓存）/ production（生产保留缓存）
ENV=production

# ── 前端品牌配置（Vite 环境变量，需 VITE_ 前缀） ─────────────────────
VITE_APP_BRAND_NAME=AIGC NEWS

# ── Redis 配置 ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT 鉴权配置 ──────────────────────────────────────────────────────
# 必须设置为强随机值，否则应用拒绝启动（缺失/示例值/长度不足 32 字符均拦截）。
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 默认管理员种子（开源自托管引导） ─────────────────────────────────
# 仅当用户表为空的首次启动时种子一个默认管理员，让无法配置 SMTP（注册/找回
# 密码依赖邮件投递）的全新部署也能登录管理端；既有部署（用户表非空）完全不触发。
# 默认值是公开凭据：登录后请立即在站点内改密（Dock 钥匙按钮 → 修改密码，
# 只需当前密码，免 SMTP）；仍用默认密码时全站会有常驻警示条。
# 任一值置空即禁用种子。
DEFAULT_ADMIN_EMAIL=admin@aigcnews.internal
DEFAULT_ADMIN_PASSWORD=admin123456

# ── SMTP 邮件配置（Phase 4 邮箱验证码） ───────────────────────────────
# SMTP_HOST 留空则进入 dev 模式：验证码直接打印到控制台日志，不发送邮件
# 生产环境请填写真实 SMTP 服务器信息
# 邮件发送配置 (Resend)
# 注意：管理员在监控页（Monitor → SMTP 邮件投递配置）保存的配置存入数据库并
# 优先于此处的环境变量（后台任务最迟 60 秒内沿用新配置）；在面板中以空主机
# 保存即可删除数据库配置、恢复使用本节的 env 值
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aigcnews.cn
SMTP_FROM_NAME=AIGCNEWS
SMTP_USE_TLS=true

# ── 邮件池（多服务商免费额度 failover，可选） ───────────────────────
# 非空时接管全部外发邮件：按 priority 升序（小者优先）投递；某家本地计数
# 达到 daily_limit/monthly_limit，或投递命中配额/限流错误时，自动切换下
# 一家，配额错误会将该家熔断至 UTC 次日。上方单 SMTP 配置（含监控页 DB
# 配置）自动并入为最低优先级兜底 entry，按 host 去重。
# 注意：限额窗口按 UTC 日/月，与服务商真实重置口径可能错位，限额请留余量；
# 配额计数存于 Redis，Redis 不可用时护栏失效、退化为纯 failover。
# 字段：name(必填) host(必填) port username password use_tls
#       from_email from_name（缺省继承上方 SMTP_FROM_*）
#       daily_limit monthly_limit（0=不做本地限额） priority（小者优先）
# 常见免费档 SMTP 端点（2026-08 核实，注册后以其面板为准）：
#   Resend        smtp.resend.com:465         用户名 resend，密码=API Key     100/日
#   Brevo         smtp-relay.brevo.com:587    用户名=登录邮箱，密码=SMTP Key  300/日
#   Mailjet       in-v3.mailjet.com:587       用户名=API Key，密码=Secret Key 200/日
#   Mailtrap      live.smtp.mailtrap.io:587   用户名 api，密码=API Token      4000/月
#   Mailgun       smtp.mailgun.org:587        面板生成的 SMTP 凭据            100/日
#   Elastic Email smtp.elasticemail.com:2525  用户名=账号邮箱，密码=API Key   100/日
# 示例（单行 JSON 数组）：
# EMAIL_POOL_JSON=[{"name":"resend","host":"smtp.resend.com","port":465,"username":"resend","password":"re_xxx","daily_limit":95,"monthly_limit":2900,"priority":10},{"name":"brevo","host":"smtp-relay.brevo.com","port":587,"username":"you@example.com","password":"xsmtpsib-xxx","daily_limit":280,"monthly_limit":8500,"priority":20}]
EMAIL_POOL_JSON=

# ── 支付收费骨架（会员订阅，ADR 0002） ─────────────────────
# 全局开关：默认关闭，用户侧 /api/payments/* 整组 404；
# 营业执照/商户号就位后逐渠道填凭证，再置 PAYMENTS_ENABLED=true
PAYMENTS_ENABLED=false
# 未支付订单挂起时长（分钟，5..1440），超时由调度任务自动关单
PAYMENTS_ORDER_TTL_MINUTES=30
# 渠道回调 notify_url 的公网基址；留空则按请求 Host 推导（生产建议显式配置）
PAYMENTS_PUBLIC_BASE_URL=
# 微信支付 v3 Native（扫码）——商户平台凭证；全部留空则该渠道 503
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MCH_SERIAL_NO=
# APIv3 密钥（商户平台设置）；切勿填 CHANGEME 占位符
WECHAT_PAY_API_V3_KEY=
# 商户 API 私钥文件路径（apiclient_key.pem）
WECHAT_PAY_PRIVATE_KEY_PATH=
# 支付宝电脑网站支付（alipay.trade.page.pay）——开放平台应用凭证
ALIPAY_APPID=
# 应用私钥 / 支付宝公钥文件路径（RSA2）
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# Stripe（国际卡）——Dashboard API key + Webhook 签名 secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── 推送渠道凭据加密（订阅推送） ─────────────────────────────
# 用于 webhook secret / bot token 等渠道凭据的静态加密（AES-256-GCM）
# 32 字节随机值的 URL-safe Base64；留空则含凭据的渠道类型不可用（email 渠道不受影响）
# 生成：python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PUSH_CHANNEL_ENCRYPTION_KEY=
PUSH_CHANNEL_ENCRYPTION_KEY_VERSION=v1

# ── DailyHot 聚合热榜上游（编排内网自托管 DailyHotApi） ─────────────
# 部署步骤见 docs/dailyhot-source.md（同级检出 + 预构建镜像 + COMPOSE_PROFILES=dailyhot）
# base_url 指向 compose 服务名，仅编排内网可达
DAILYHOT_API_BASE_URL=http://dailyhot:6688
# 逗号分隔的 DailyHotApi 端点路由名（可选端点见其仓库 src/routes/）
DAILYHOT_ENDPOINTS=36kr,ithome,sspai,juejin,zhihu,huxiu,geekpark,ifanr
DAILYHOT_PER_ENDPOINT_LIMIT=5
DAILYHOT_REQUEST_TIMEOUT_SECONDS=8.0

# ── SiliconFlow API 配置（Reranker + 视觉模型） ───────────────────────
# 用于 /v1/rerank（Reranker）和 /v1/chat/completions（视觉问答）
SILICONFLOW_API_KEY=
RERANKER_MODEL_NAME=Pro/BAAI/bge-reranker-v2-m3
# 视觉模型（与 SILICONFLOW_API_KEY 复用同一 key，保留兼容旧配置项）
VISION_API_KEY=
