FROM python:3.10-slim

WORKDIR /src

COPY backend/requirements.txt /src/requirements.txt
RUN pip install --no-cache-dir -i https://mirrors.cloud.tencent.com/pypi/simple -r /src/requirements.txt

COPY backend /src/backend
COPY scripts /src/scripts
COPY docker/docker-compose.project-catalog-rehearsal.yml /src/docker/docker-compose.project-catalog-rehearsal.yml

ENV PYTHONPATH=/src
ENV HF_ENDPOINT=https://hf-mirror.com
ENV HF_HUB_OFFLINE=0
ENV TRANSFORMERS_OFFLINE=0

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
