# 环境变量（极度机密）
.env
**/.env

# Python 虚拟环境与缓存
.venv
venv/
__pycache__/
*.pyc

# Node.js 依赖与前端打包产物
**/node_modules/
frontend/dist/
dist/

# 数据库本地真实数据与日志 (核心隔离)
docker/volumes/
data/
*.log

# AI 助手本地缓存
.roo/
.claude/worktrees/

# 系统级隐藏文件 (可选)
.DS_Store

# PDF 论文本地存储（保留目录结构，忽略 PDF 文件本身）
storage/papers/*.pdf
# HuggingFace 模型缓存（大文件，不入 git）
storage/hf_cache/
# MCP 工具调用计数持久化文件（运行态数据，不入 git）
storage/metrics/
# 微信公众号图片代理缓存（运行态数据，不入 git）
storage/wechat/
# X 媒体缓存（海报/视频代理产物，运行态数据，不入 git）
storage/x_media/
# 以 backend/ 或 frontend/ 为 CWD 运行时泄漏的嵌套 storage 产物
backend/storage/
frontend/storage/

# SSL 证书私钥（极度机密，绝不入 git）
**/*.key
aigcnews.cn_nginx.zip
frontend/ssl/
ssl/

# Generated test artifacts
test-results/

# Private project-search judgments and web snapshots
benchmarks/project-search/private/

# One-shot MySQL retirement evidence and dumps (keep out of VCS)
migration-artifacts/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
