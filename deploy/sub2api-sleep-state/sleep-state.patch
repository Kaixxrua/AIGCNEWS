+func TestLegacyBridgePreservesAuthoritativeUsage(t *testing.T) {
+	for _, usage := range []string{"", `{"input_tokens":103,"output_tokens":21,"total_tokens":124,"input_tokens_details":{"cached_tokens":17},"future_counter":9}`} {
+		e, _ := testEngine(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "text/event-stream")
+			suffix := ""
+			if usage != "" {
+				suffix = `,"usage":` + usage
+			}
+			fmt.Fprintf(w, "data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"compaction\",\"encrypted_content\":\"opaque\"}]%s}}\n\n", suffix)
+		}))
+		r := request(compactFixtureRequest, "usage-test-token")
+		r.URL.Path = "/backend-api/codex/responses/compact"
+		w := httptest.NewRecorder()
+		e.ServeHTTP(w, r)
+		var result map[string]json.RawMessage
+		if w.Code != 200 || json.Unmarshal(w.Body.Bytes(), &result) != nil {
+			t.Fatalf("unexpected response status %d", w.Code)
+		}
+		if string(result["usage"]) != usage {
+			t.Fatalf("usage changed: got %s, want %s", result["usage"], usage)
+		}
+	}
+}
