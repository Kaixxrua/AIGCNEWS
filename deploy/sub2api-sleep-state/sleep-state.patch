 2 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/internal/gateway/compact.go b/internal/gateway/compact.go
index e4de2bc..47b0668 100644
--- a/internal/gateway/compact.go
+++ b/internal/gateway/compact.go
@@ -93,7 +93,8 @@ func (e *Engine) bridgeCompactResponse(resp *http.Response, s *session, route in
 	body, err := json.Marshal(struct {
 		Object string            `json:"object"`
 		Output []json.RawMessage `json:"output"`
-	}{"response.compaction", output})
+		Usage  json.RawMessage   `json:"usage,omitempty"`
+	}{"response.compaction", output, compactResponseUsage(data)})
 	if err != nil || len(body) > maxCompactBytes {
 		return &compactError{502, "compact_response_too_large", "转换后的远程压缩结果超过大小限制；请求不会重放。"}
 	}
@@ -111,6 +112,27 @@ func (e *Engine) bridgeCompactResponse(resp *http.Response, s *session, route in
 	return nil
 }
 
+// Preserve the authoritative usage object for gateways that account for
+// compaction. Missing upstream usage remains missing; never invent token counts.
+func compactResponseUsage(data []byte) json.RawMessage {
+	var usage json.RawMessage
+	walkSSE(data, func(name string, payload []byte) {
+		var event struct {
+			Type     string `json:"type"`
+			Response struct {
+				Usage json.RawMessage `json:"usage"`
+			} `json:"response"`
+		}
+		if json.Unmarshal(payload, &event) != nil {
+			return
+		}
+		if event.Type == "response.completed" || (event.Type == "" && name == "response.completed") {
+			usage = event.Response.Usage
+		}
+	})
+	return usage
+}
+
 func compactOutput(data []byte) ([]json.RawMessage, error) {
 	var emitted, output []json.RawMessage
 	invalid := false
