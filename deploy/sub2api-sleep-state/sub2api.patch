diff --git a/backend/internal/service/openai_sleep_state.go b/backend/internal/service/openai_sleep_state.go
new file mode 100644
index 000000000..99affe8f7
--- /dev/null
+++ b/backend/internal/service/openai_sleep_state.go
@@ -0,0 +1,60 @@
+package service
+
+import (
+	"errors"
+	"net"
+	"net/http"
+	"time"
+)
+
+// The sidecar shares the gateway network namespace. A fixed loopback destination
+// prevents account metadata from redirecting OAuth credentials to arbitrary hosts.
+const openAISleepStateAddress = "127.0.0.1:17841"
+
+var openAISleepStateClient = &http.Client{
+	Transport: &http.Transport{
+		Proxy:                 nil,
+		DialContext:           (&net.Dialer{Timeout: 5 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
+		MaxIdleConns:          100,
+		MaxIdleConnsPerHost:   20,
+		IdleConnTimeout:       90 * time.Second,
+		ResponseHeaderTimeout: 3 * time.Minute,
+	},
+	Timeout:       30 * time.Minute,
+	CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse },
+}
+
+func (a *Account) IsOpenAISleepStateEnabled() bool {
+	if a == nil || !a.IsOpenAI() || a.Type != AccountTypeOAuth {
+		return false
+	}
+	enabled, _ := a.Extra["openai_sleep_state_enabled"].(bool)
+	return enabled
+}
+
+func roundTripOpenAISleepState(request *http.Request, account *Account) (*http.Response, bool, error) {
+	if !account.IsOpenAISleepStateEnabled() || request == nil || request.URL == nil {
+		return nil, false, nil
+	}
+	// Preserve unrelated endpoints such as usage and token refresh on their native path.
+	if request.URL.Scheme != "https" || request.URL.Host != "chatgpt.com" || request.URL.RawPath != "" {
+		return nil, false, nil
+	}
+	path := request.URL.Path
+	if !((request.Method == http.MethodPost && (path == "/backend-api/codex/responses" || path == "/backend-api/codex/responses/compact" || path == "/backend-api/codex/alpha/search")) ||
+		(request.Method == http.MethodGet && path == "/backend-api/codex/models")) {
+		return nil, false, nil
+	}
+	forward := request.Clone(request.Context())
+	forward.URL.Scheme = "http"
+	forward.URL.Host = openAISleepStateAddress
+	forward.Host = openAISleepStateAddress
+	forward.Header.Del("Proxy-Authorization")
+	// Do not retry a consumed generation if the sidecar or upstream fails.
+	forward.GetBody = nil
+	response, err := openAISleepStateClient.Do(forward)
+	if err != nil {
+		return nil, true, errors.New("sleep-state sidecar request failed")
+	}
+	return response, true, nil
+}
diff --git a/backend/internal/service/openai_sleep_state_test.go b/backend/internal/service/openai_sleep_state_test.go
new file mode 100644
index 000000000..9acefb7a0
--- /dev/null
+++ b/backend/internal/service/openai_sleep_state_test.go
@@ -0,0 +1,121 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type sleepStateTestTransport func(*http.Request) (*http.Response, error)
+
+func (f sleepStateTestTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func sleepStateTestAccount() *Account {
+	return &Account{ID: 821, Platform: PlatformOpenAI, Type: AccountTypeOAuth,
+		Extra: map[string]any{"openai_sleep_state_enabled": true}}
+}
+
+func TestSleepStateAccountIsolation(t *testing.T) {
+	for _, account := range []*Account{nil, {},
+		{Platform: PlatformOpenAI, Type: AccountTypeOAuth},
+		{Platform: PlatformOpenAI, Type: AccountTypeOAuth, Extra: map[string]any{"openai_sleep_state_enabled": "true"}},
+		{Platform: PlatformOpenAI, Type: AccountTypeAPIKey, Extra: map[string]any{"openai_sleep_state_enabled": true}},
+		{Platform: PlatformAnthropic, Type: AccountTypeOAuth, Extra: map[string]any{"openai_sleep_state_enabled": true}},
+	} {
+		require.False(t, account.IsOpenAISleepStateEnabled())
+		req, err := http.NewRequest(http.MethodPost, chatgptCodexURL, nil)
+		require.NoError(t, err)
+		_, handled, err := roundTripOpenAISleepState(req, account)
+		require.NoError(t, err)
+		require.False(t, handled)
+	}
+	account := sleepStateTestAccount()
+	require.True(t, account.IsOpenAIWSForceHTTPEnabled())
+	require.Equal(t, OpenAIWSIngressModeHTTPBridge, account.ResolveOpenAIResponsesWebSocketV2Mode(OpenAIWSIngressModePassthrough))
+	require.Equal(t, OpenAIUpstreamTransportHTTPSSE, NewOpenAIWSProtocolResolver(nil).Resolve(account).Transport)
+}
+
+func TestSleepStateForwardingContract(t *testing.T) {
+	original := openAISleepStateClient
+	t.Cleanup(func() { openAISleepStateClient = original })
+	for _, path := range []string{"/responses", "/responses/compact", "/alpha/search", "/models"} {
+		t.Run(path, func(t *testing.T) {
+			method := http.MethodPost
+			if path == "/models" {
+				method = http.MethodGet
+			}
+			payload := `{"model":"gpt-6-astra","input":"test","stream":true}`
+			req, err := http.NewRequestWithContext(context.Background(), method, "https://chatgpt.com/backend-api/codex"+path+"?client_version=test", strings.NewReader(payload))
+			require.NoError(t, err)
+			req.Host = "chatgpt.com"
+			req.Header.Set("Authorization", "Bearer synthetic-token")
+			req.Header.Set("ChatGPT-Account-ID", "synthetic-account")
+			req.Header.Set("X-Codex-Turn-State", "synthetic-state")
+			req.Header.Set("Proxy-Authorization", "must-not-leak")
+			calls := 0
+			openAISleepStateClient = &http.Client{Transport: sleepStateTestTransport(func(forward *http.Request) (*http.Response, error) {
+				calls++
+				require.Equal(t, "http://"+openAISleepStateAddress+"/backend-api/codex"+path+"?client_version=test", forward.URL.String())
+				require.Equal(t, openAISleepStateAddress, forward.Host)
+				require.Equal(t, req.Header.Get("Authorization"), forward.Header.Get("Authorization"))
+				require.Equal(t, "synthetic-account", forward.Header.Get("ChatGPT-Account-ID"))
+				require.Equal(t, "synthetic-state", forward.Header.Get("X-Codex-Turn-State"))
+				require.Empty(t, forward.Header.Get("Proxy-Authorization"))
+				require.Nil(t, forward.GetBody)
+				body, err := io.ReadAll(forward.Body)
+				require.NoError(t, err)
+				require.Equal(t, payload, string(body))
+				return &http.Response{StatusCode: 200, Header: http.Header{"X-Codex-Turn-State": {"returned-state"}}, Body: io.NopCloser(strings.NewReader("data: test\n\n"))}, nil
+			})}
+			response, handled, err := roundTripOpenAISleepState(req, sleepStateTestAccount())
+			require.NoError(t, err)
+			require.True(t, handled)
+			require.Equal(t, 1, calls)
+			require.Equal(t, "returned-state", response.Header.Get("X-Codex-Turn-State"))
+			body, err := io.ReadAll(response.Body)
+			require.NoError(t, err)
+			require.Equal(t, "data: test\n\n", string(body))
+			require.NoError(t, response.Body.Close())
+			require.Equal(t, "chatgpt.com", req.Host)
+			require.Equal(t, "https", req.URL.Scheme)
+			require.Equal(t, "must-not-leak", req.Header.Get("Proxy-Authorization"))
+		})
+	}
+}
+
+func TestSleepStateEndpointBoundary(t *testing.T) {
+	for _, target := range []string{"https://example.com/backend-api/codex/responses", "http://chatgpt.com/backend-api/codex/responses", "https://chatgpt.com/backend-api/codex/usage", "https://chatgpt.com/backend-api/codex/%72esponses"} {
+		req, err := http.NewRequest(http.MethodPost, target, nil)
+		require.NoError(t, err)
+		_, handled, err := roundTripOpenAISleepState(req, sleepStateTestAccount())
+		require.NoError(t, err)
+		require.False(t, handled)
+	}
+}
+
+func TestSleepStateFailureDoesNotReplayOrLeak(t *testing.T) {
+	original := openAISleepStateClient
+	t.Cleanup(func() { openAISleepStateClient = original })
+	calls := 0
+	openAISleepStateClient = &http.Client{Transport: sleepStateTestTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return nil, errors.New("synthetic-private-upstream-error")
+	})}
+	req, err := http.NewRequest(http.MethodPost, chatgptCodexURL, strings.NewReader(`{}`))
+	require.NoError(t, err)
+	// A nil native upstream would panic if the sidecar error fell through.
+	_, err = (&OpenAIGatewayService{}).doOpenAIUpstream(req, "socks5://must-not-be-used", sleepStateTestAccount())
+	require.EqualError(t, err, "sleep-state sidecar request failed")
+	require.Equal(t, 1, calls)
+}
+
+func TestSleepStateClientSecurityDefaults(t *testing.T) {
+	transport := openAISleepStateClient.Transport.(*http.Transport)
+	require.Nil(t, transport.Proxy)
+	require.ErrorIs(t, openAISleepStateClient.CheckRedirect(nil, nil), http.ErrUseLastResponse)
+}
